# OpenClaw backend for `beast` (RTX 3070 Ti Laptop, 8 GB, Ampere sm86).
# vLLM serving language-only INT4-AWQ Qwen3.5-4B behind the OpenClaw contract:
# OpenAI API on :11434, model name "openclaw". A drop-in replacement for the
# Ollama openclaw service on this host — apps need no change.
#
# WHY vLLM here (not Ollama, not TensorRT-LLM): on consumer Ampere the modern
# TensorRT-LLM pytorch backend cannot serve a working quantized model — INT4
# (W4A16-AWQ) loads fast but miscomputes into garbage, INT8 (W8A8) is
# "unsupported quant mode", and FP8/FP4 need newer GPUs. vLLM's Marlin W4A16
# kernels run correctly on this GPU. Full story: ../TRTLLM_MIGRATION.md and
# ../BENCHMARKS.md.
#
# The Jetson uses MLC-LLM (see mlc/openclaw-mlc.service), while this host uses
# vLLM. Each host runs one backend behind the same OpenAI-compatible contract.
#
# Runs the vLLM container in the foreground under systemd (Type=simple): systemd
# tracks the `docker run` client and forwards SIGTERM on stop. Requires the
# invoking user to be in the `docker` group.
#
# Install to ~/.config/systemd/user/openclaw-vllm.service (install-vllm.sh does
# this). Needs lingering so it runs without an active login:
#   loginctl enable-linger "$USER"

[Unit]
Description=OpenClaw shared local LLM (vLLM, INT4-AWQ Qwen3.5-4B, LAN :11434)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Swap OPENCLAW_MODEL to change the model for every app at once (mirrors the
# Modelfile's role on the Ollama hosts). Must be an AWQ / compressed-tensors
# checkpoint that fits ~8 GB.
Environment=OPENCLAW_MODEL=QuantTrio/Qwen3.5-4B-AWQ
Environment=OPENCLAW_PORT=11434
Environment=VLLM_IMAGE=vllm/vllm-openai:latest
# Qwen3.5's GDN/FLA execution requires transient workspace beyond the explicit
# KV cache. On Beast's 8 GB GPU, admit four active sequences, use a 6,144-token
# total sequence limit, reserve 1.2 GB for FP8 KV, and prefill in 1,024-token
# waves so GDN/FLA workspace retains headroom; additional requests queue safely.
# Clear any stale container left by a hard crash before (re)starting.
ExecStartPre=-/usr/bin/docker rm -f openclaw-vllm
ExecStart=/usr/bin/docker run --rm --name openclaw-vllm --gpus all --ipc=host -p ${OPENCLAW_PORT}:8000 -e PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True -v %h/.cache/huggingface:/root/.cache/huggingface ${VLLM_IMAGE} ${OPENCLAW_MODEL} --revision 32c292e3a73afe1138518180b1b6d2868c980ee2 --served-model-name openclaw --language-model-only --default-chat-template-kwargs '{"enable_thinking":false}' --max-model-len 6144 --max-num-seqs 4 --max-num-batched-tokens 1024 --gpu-memory-utilization 0.95 --kv-cache-dtype fp8 --kv-cache-memory 1200000000 --enforce-eager --enable-auto-tool-choice --tool-call-parser qwen3_coder
ExecStop=/usr/bin/docker stop openclaw-vllm
ExecStopPost=-/usr/bin/docker rm -f openclaw-vllm
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
