# OpenClaw backend for AWS EC2 g6.xlarge (NVIDIA L4, 24 GB VRAM).
#
# Serves Gemma 4 12B QAT W4A16 through the OpenAI-compatible API as
# "openclaw". The host port is deliberately bound to loopback; Caddy exposes
# the bearer-authenticated API over HTTPS.
#
# Install with ../install-vllm-ec2.sh. This is a system service (not a user
# service), so it starts after Docker whenever the EC2 instance boots.

[Unit]
Description=OpenClaw shared LLM on EC2 (vLLM, Gemma 4 12B W4A16, loopback :11434)
After=network-online.target docker.service openclaw-ec2-init.service
Wants=network-online.target openclaw-ec2-init.service
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/openclaw-vllm-ec2.env
ExecStartPre=-/usr/bin/docker rm -f openclaw-ec2-vllm
ExecStart=/usr/bin/docker run --rm --name openclaw-ec2-vllm --gpus all --ipc=host -p 127.0.0.1:11434:8000 ${OPENCLAW_ECR_IMAGE} --model /models/gemma-4-12b-w4a16 --served-model-name openclaw --api-key ${VLLM_API_KEY} --language-model-only --quantization compressed-tensors --dtype auto --kv-cache-dtype fp8 --max-model-len 16384 --gpu-memory-utilization 0.95 --max-num-seqs 4 --enforce-eager
ExecStop=/usr/bin/docker stop -t 30 openclaw-ec2-vllm
ExecStopPost=-/usr/bin/docker rm -f openclaw-ec2-vllm
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
